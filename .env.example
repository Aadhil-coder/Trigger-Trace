# TriggerTrace: example settings
# Copy this file to ".env" and fill in the values.
# Never commit the real ".env" file.

# ---------- Flask ----------
FLASK_ENV=development
FLASK_DEBUG=1
# Any long random string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
PORT=8000

# ---------- Database ----------
DATABASE_PATH=instance/triggertrace.db

# ---------- Demo location (district level only) ----------
DEFAULT_DISTRICT=
DEFAULT_LATITUDE=
DEFAULT_LONGITUDE=

# ---------- Data sources ----------
# Open-Meteo needs no API key for non-commercial use. Check their current terms and limits.
OPEN_METEO_WEATHER_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
# OpenAQ is optional. If you use it, add your key here.
OPENAQ_API_KEY=

# ---------- Caching and demo mode ----------
CACHE_DIR=data/cache
# Set to 1 to use only cached data (demo works without internet)
USE_CACHE_ONLY=0

# ---------- Analysis thresholds (proposed, tune on synthetic data) ----------
MIN_ATTACKS=10
MIN_CHECKIN_DAYS=30
BOOTSTRAP_RESAMPLES=500

# ---------- CORS (frontend address allowed to call the backend) ----------
CORS_ORIGINS=http://localhost:5173

# ---------- Frontend (copy to frontend/.env) ----------
# VITE_API_URL=http://localhost:8000